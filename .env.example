# ==============================================
# ENVIRONMENT FILE - Copy to .env and configure
# ==============================================
# For development: Use simple values
# For production: Use strong passwords and your domain

# Django Settings
SECRET_KEY=your-secret-key-change-in-production
DEBUG=1
# Space-separated list of allowed hosts
ALLOWED_HOSTS=localhost 127.0.0.1 0.0.0.0

# CORS Settings (for API access from frontend)
CORS_ORIGIN_WHITELIST=localhost 127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mydb
DB_USER=admin
DB_PASSWORD=admin
DB_HOST=db
DB_PORT=5432

# Port Configuration
BACKEND_PORT=8000
# Development: expose DB port for external tools
# Production: comment out or set to a non-standard port
DB_EXTERNAL_PORT=5439

# Production-only settings (change these for production)
# ALLOWED_HOSTS=yourdomain.com www.yourdomain.com your-server-ip
# DEBUG=0
# SECRET_KEY=very-long-random-string-at-least-50-characters-long
# DB_PASSWORD=strong-random-password-here
# DB_NAME=production_db
# DB_USER=produser
# #DB_EXTERNAL_PORT= (comment out to not expose DB port)
