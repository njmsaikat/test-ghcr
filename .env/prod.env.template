# Database Configuration
PRODUCTION=True
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mydb
DB_USER=admin
DB_PASSWORD=change-this-to-strong-password
DB_HOST=db
DB_PORT=5432

# GitHub Container Registry (for reference)
