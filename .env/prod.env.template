# PRODUCTION ENVIRONMENT TEMPLATE
# Copy this file and rename to .env.prod
# Fill in your actual production values

# Django Settings
SECRET_KEY=your-production-secret-key-here-make-it-long-and-random
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-server-ip
DEBUG=False

# CORS Settings (adjust for your frontend domain)
CORS_ORIGIN_WHITELIST=yourdomain.com,www.yourdomain.com
